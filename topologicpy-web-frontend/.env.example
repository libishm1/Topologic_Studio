# Backend base URL. Defaults to http://localhost:8000 when unset.
VITE_API_BASE=http://localhost:8000

# Where the web-ifc WASM runtime is served from. Defaults to /wasm/, which
# `npm run sync-wasm` populates from node_modules so no CDN is involved.
# VITE_WEBIFC_WASM_PATH=/wasm/

# Print timing markers to the console in production builds too.
# VITE_PERF_LOG=1
